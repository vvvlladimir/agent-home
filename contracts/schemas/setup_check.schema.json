{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setup_check.schema.json",
  "title": "SetupCheck",
  "description": "Written by `jetson/setup.sh --check --json` to owner-reports/setup/<date>_check.json. Read-only facts about the Jetson; nothing is changed by --check.",
  "type": "object",
  "required": ["schema_version", "kind", "created", "checks"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "setup_check"},
    "created": {"type": "string"},
    "module": {"type": ["string", "null"]},
    "is_orin_nano_8gb": {"type": ["boolean", "null"]},
    "l4t_version": {"type": ["string", "null"]},
    "jetpack_major": {"type": ["integer", "null"]},
    "ubuntu": {"type": ["string", "null"]},
    "cuda_version": {"type": ["string", "null"]},
    "ram_total_mb": {"type": ["number", "null"]},
    "ram_available_mb": {"type": ["number", "null"]},
    "swap_total_mb": {"type": ["number", "null"]},
    "zram_enabled": {"type": ["boolean", "null"]},
    "power_mode": {"type": ["string", "null"]},
    "power_modes_available": {"type": "array", "items": {"type": "string"}, "description": "`id:name` pairs parsed from `nvpmodel -p --verbose`"},
    "default_target": {"type": ["string", "null"], "description": "systemctl get-default"},
    "disk_free_gb": {"type": ["number", "null"]},
    "llama_server_path": {"type": ["string", "null"]},
    "llama_server_version": {"type": ["string", "null"]},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["ok", "warn", "fail", "skip"]},
          "detail": {"type": "string"},
          "would_change": {"type": "string", "description": "what setup.sh (without --check) would do about it"}
        }
      }
    }
  }
}
