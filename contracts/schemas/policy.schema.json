{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy.schema.json",
  "title": "Policy",
  "description": "Global tier policy, stored in /data/policy.yaml. Deny by default: a domain that is not listed is T3. Tiers: T0 free, T1 act+notify, T2 act only after human approval, T3 never.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "domain_tiers": {
      "type": "object",
      "additionalProperties": {"enum": ["T0", "T1", "T2", "T3"]},
      "default": {
        "light": "T0", "media_player": "T0", "fan": "T0",
        "scene": "T2", "input_boolean": "T2", "input_select": "T2", "humidifier": "T1", "vacuum": "T1",
        "climate": "T2", "cover": "T2", "switch": "T2", "water_heater": "T2", "input_number": "T2",
        "lock": "T3", "alarm_control_panel": "T3", "valve": "T3", "siren": "T3", "camera": "T3"
      }
    },
    "entity_tiers": {
      "type": "object",
      "description": "entity_id or glob -> tier. An exact id beats globs; among globs the strictest wins. If the domain, the exact entry or any matching glob says T3, the entity is T3 and only t3_whitelist can lift it (to T2).",
      "additionalProperties": {"enum": ["T0", "T1", "T2", "T3"]},
      "default": {"cover.*garage*": "T3", "input_select.agent_house_mode": "T1"}
    },
    "t3_whitelist": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"},
      "default": [],
      "description": "Read-only here: the add-on option t3_whitelist (HA Configuration tab). Exact entity ids the owner explicitly allows despite a T3 domain. They become T2 (approval required), never lower. No globs. PUT /api/policy accepts it only unchanged."
    },
    "allowed_services": {
      "type": "object",
      "description": "domain -> services agents may call. A service that is not listed is denied whatever the tier.",
      "additionalProperties": {"type": "array", "items": {"type": "string"}},
      "default": {
        "light": ["turn_on", "turn_off", "toggle"],
        "media_player": ["turn_on", "turn_off", "media_play", "media_pause", "media_stop", "volume_set", "volume_mute"],
        "fan": ["turn_on", "turn_off", "set_percentage"],
        "scene": ["turn_on"],
        "input_boolean": ["turn_on", "turn_off"],
        "input_select": ["select_option"],
        "humidifier": ["turn_on", "turn_off", "set_humidity"],
        "vacuum": ["start", "return_to_base"],
        "climate": ["set_temperature", "set_hvac_mode", "turn_on", "turn_off"],
        "cover": ["open_cover", "close_cover", "set_cover_position", "stop_cover"],
        "switch": ["turn_on", "turn_off"],
        "water_heater": ["set_temperature"],
        "input_number": ["set_value"]
      }
    },
    "rate_limits": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "per_entity_per_minute": {"type": "integer", "minimum": 1, "default": 4},
        "global_per_minute": {"type": "integer", "minimum": 1, "default": 30}
      }
    },
    "approval_ttl_s": {"type": "integer", "minimum": 30, "default": 900, "description": "A pending T2 approval expires after this long."}
  }
}
