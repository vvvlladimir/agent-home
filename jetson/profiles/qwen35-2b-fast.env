MODEL_HF=unsloth/Qwen3.5-2B-GGUF:Q4_K_M
CTX_SIZE=8192
N_GPU_LAYERS=99
PARALLEL=1
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
THINKING=off
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
EXTRA_ARGS=
