# Comparison candidate: Gemma 4 E2B (native function calling). No thinking switch is passed:
# the template's own default is used. The vendor suggests 8-bit quants for E2B; Q4_K_M is the
# like-for-like comparison with the Qwen profiles (see models.md for trying Q8_0).
PROFILE_NAME=gemma4-e2b-compare
MODEL_HF=unsloth/gemma-4-E2B-it-GGUF:Q4_K_M
CTX_SIZE=8192
N_GPU_LAYERS=99
PARALLEL=1
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
THINKING=default
CHAT_TEMPLATE_KWARGS=
EXTRA_ARGS=
