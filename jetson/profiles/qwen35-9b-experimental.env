# Experiment: the 9B fills the 8 GB. Smaller context to keep the KV cache small; expect little
# headroom. Not part of bench/run_all.sh unless --include-experimental is given.
PROFILE_NAME=qwen35-9b-experimental
MODEL_HF=unsloth/Qwen3.5-9B-GGUF:Q4_K_M
CTX_SIZE=4096
N_GPU_LAYERS=99
PARALLEL=1
FLASH_ATTN=on
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
THINKING=off
CHAT_TEMPLATE_KWARGS='{"enable_thinking":false}'
EXTRA_ARGS=
